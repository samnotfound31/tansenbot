# ─── Docker ignore file ───────────────────────────────────────────────────────
# Prevents secrets, local data, and dev artifacts from being baked into the image

# Secrets — NEVER include these in the Docker image
.env
.env.local
.env.*.local
secrets.json
tokens.py
secrets.py
*.key
*.pem
cookies.txt

# Database files
*.db
*.sqlite
*.sqlite3

# Local data (mounted as volumes at runtime instead)
data/

# Git history (not needed in container)
.git/
.gitignore

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
env/
venv/
venv.bak/
ENV/
.Python

# Dev tools
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Cache
.cache/

# Lavalink
lavalink/plugins/
Lavalink.jar
